{
  "name": "guidehollow-genre-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/prepare-portal-assets.mjs && astro dev --config astro.portal.config.mjs --host 0.0.0.0",
    "build": "npm run build:portal",
    "build:portal": "node scripts/prepare-portal-assets.mjs && astro build --config astro.portal.config.mjs && node scripts/verify-portal.mjs",
    "preview": "astro preview --config astro.portal.config.mjs --host 0.0.0.0",
    "check": "node scripts/verify-portal.mjs",
    "test:client": "node scripts/test-launch-note.mjs && node scripts/test-portal-client.mjs",
    "sync": "node scripts/sync-portal-catalog.mjs",
    "indexnow": "node scripts/notify-portal-indexnow.mjs",
    "build:legacy": "node scripts/prepare-assets.mjs && astro build --config astro.config.mjs && node scripts/verify-build.mjs",
    "indexnow:legacy": "node scripts/notify-indexnow.mjs",
    "build:genres": "node scripts/build-major-genres.mjs"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "jsdom": "31.0.0"
  }
}
