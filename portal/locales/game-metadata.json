  "summaries": {
    "ko": {
      "car-destruction-king": "회전 망치와 대형 프레스, 발사대가 놓인 코스에서 여러 자동차를 몰아 충돌 실험을 해보세요. 차량을 바꾸고 시간을 느리게 돌려 파손 장면을 관찰하거나, 다른 맵에서 기록에 도전할 수 있습니다.",
      "pocket-universe": "나무와 광물, 수정 등을 채집해 작은 세계의 땅을 하나씩 넓혀가는 탐험 게임입니다. 도구를 강화해 새로운 지역을 열고, 희귀한 재료를 지키는 몬스터와 맞서며 나만의 우주를 키워 보세요.",
      "domino-online-multiplayer": "도미노 패를 이어 놓으며 상대보다 먼저 손패를 비우는 전략 대전입니다. 컴퓨터와 연습하거나 친구에게 초대 링크를 보내고, 온라인 상대와 실시간으로 수를 겨룰 수 있습니다.",
      "english-checkers-online-multiplayer": "대각선으로 말을 움직이고 상대의 말을 뛰어넘어 잡는 영국식 체커 대전입니다. 온라인 상대나 친구와 맞붙거나 컴퓨터를 상대로 다음 수를 연습하며 판을 장악해 보세요.",
      "chess-online-multiplayer": "체스의 기본 규칙으로 상대 킹을 체크메이트하는 온라인 대전 게임입니다. 컴퓨터를 상대로 연습한 뒤 친구나 다른 플레이어에게 도전하고, 상대의 위협을 읽으며 기물을 배치해 보세요.",
      "escape-from-the-crypt": "지하묘지의 방을 하나씩 통과하며 강령술사에게 붙잡히기 전에 탈출하세요. 적은 더 빠르지만 장애물을 피해 가지 못하므로, 막다른 길로 유인하며 다음 이동을 계산하는 것이 핵심입니다.",
      "dead-frequency": "붉은 황무지의 신호탑을 향해 몰려오는 적의 파도를 막는 타워 디펜스입니다. 공격력·발사 속도·튕기는 탄환 같은 능력을 강화하고 자원을 관리해 신호탑을 최대한 오래 지켜내세요.",
      "cannon-basket": "대포에서 공을 쏘아 농구 골대에 넣는 물리 퍼즐입니다. 움직이는 발판의 위치를 조절해 공의 궤도를 바꾸고, 각기 다른 45개 단계에서 정확한 타이밍과 각도를 찾아보세요.",
      "knight-legend": "기사를 이끌고 몬스터와 싸우며 새로운 지역으로 나아가는 성장형 액션 게임입니다. 전투로 얻은 보상으로 방어구를 강화하고 함께 싸울 펫을 마련해 더 강한 적에게 도전하세요.",
      "fruit-fusion": "체리부터 수박까지 같은 과일 두 개를 맞붙여 더 큰 과일로 합치는 낙하 퍼즐입니다. 과일이 쌓이는 위치를 계산하고 연쇄 합성을 노리되, 통이 넘치지 않도록 다음 한 수를 준비해야 합니다.",
      "heart-box": "배터리가 약한 로봇 로비를 충전 지점까지 보내는 물리 퍼즐입니다. 상자와 장애물 등 주변 물체를 움직이거나 제거해 길을 만들고, 방마다 달라지는 실험 장치를 활용해 보세요.",
      "mahjong-unlimited": "좌우 한쪽이 열려 있고 위에 패가 덮이지 않은 마작 패를 같은 그림끼리 짝지어 없애세요. 시간이 없는 편안한 모드부터 시간 제한 도전까지 골라 다양한 난도의 판을 풀 수 있습니다.",
      "battle-of-banners": "육각형 전장에서 기사 부대를 지휘해 영토를 넓히는 턴제 전략 게임입니다. 병사를 이동하거나 공격할 때마다 한 턴이 소모되므로, 숲과 길목을 활용해 적 병사와 건물을 제거해야 합니다.",
      "solitaire-picture-puzzles": "그림이 그려진 카드를 서로 바꿔 올바른 위치에 맞추며 한 장의 그림을 복원하세요. 3×3의 쉬운 판부터 시작해 뒤로 갈수록 복잡해지는 카드 배치 퍼즐을 해결합니다.",
      "hero-defense-king": "적이 몰려오는 길목에서 영웅의 기술과 방어 시설을 활용해 탑을 지키세요. 웨이브가 지날수록 강해지는 적에 맞춰 능력을 강화하고, 기술을 언제 사용할지 판단하는 전략이 중요합니다.",
      "purrfect-match": "보호소에서 기다리는 고양이들을 같은 색 세 마리씩 맞춰 집으로 데려오는 매치 퍼즐입니다. 네 마리·다섯 마리를 연결하면 강력한 특수 아이템이 만들어져 복잡한 판을 빠르게 정리할 수 있습니다.",
      "screw-match": "유리 너트에 꽂힌 여러 색의 나사를 풀어 같은 색의 상자에 옮기는 분류 퍼즐입니다. 상자의 빈칸과 다음에 나올 상자를 고려하며 나사를 고르면 막히지 않고 판을 정리할 수 있습니다.",
      "doodle-boba-bubble-tea": "과일 젤리와 타피오카, 다양한 맛의 재료를 섞어 버블티 주문을 완성하세요. 고객이 원하는 조합과 양에 맞춰 차를 만들고 주문을 정확히 처리하며 음료 가게를 운영합니다.",
      "cubegate": "미래적인 실험실에서 빛나는 큐브를 옮겨 압력판 위에 놓는 퍼즐 플랫폼 게임입니다. 큐브로 문과 다리, 승강기에 전력을 공급하고 이동 순서와 점프 타이밍을 맞춰 다음 방으로 나아가세요.",
      "doodle-halloween-momo-cat-academy": "마법 고양이 모모가 학교에 나타난 유령을 물리치고 사라진 마법책을 되찾는 게임입니다. 유령 머리 위에 표시된 기호를 마우스나 손가락으로 빠르게 그려 주문을 발동하세요.",
      "doodle-halloween-momo-cat--sea-magic": "마법 고양이 모모가 바닷속으로 내려가 해양 생물에 숨어든 유령을 쫓아냅니다. 유령 위에 떠 있는 문양을 순서대로 빠르게 그려 마법을 쓰고, 더 깊은 바다에서 늘어나는 적에 맞서세요.",
      "syntagma": "신비한 나침반과 고대 지도를 단서로 다섯 개의 버려진 사원을 찾아가는 퍼즐 모험입니다. 장애물을 피해 발판을 옮기고 곳곳에 흩어진 원소의 수정을 모아 사원의 비밀을 밝혀 보세요.",
      "favorite-puzzles": "좋아하는 사진을 골라 조각을 맞추는 직소 퍼즐 모음입니다. 그림을 6조각부터 최대 1,200조각까지 나눌 수 있어 가볍게 시작하거나 복잡한 그림에 오래 집중할 수 있습니다.",
      "maskinery-idle": "신비로운 섬의 칸을 하나씩 정리하고 적을 물리쳐 특별한 능력의 가면을 모으는 방치형 게임입니다. 금화로 능력을 강화하고 마지막 구역의 보스를 쓰러뜨려 다음 섬을 해금하세요.",
      "relaxing-games-30-in-1": "짧은 휴식에 즐길 수 있는 작은 게임 30종을 한 화면에서 골라 플레이하세요. 게임마다 간단한 목표와 조작이 달라, 한 게임에 오래 머물지 않고 여러 종류의 미니게임을 번갈아 즐길 수 있습니다.",
      "fillblox": "크기가 서로 다른 블록을 빈 격자에 끼워 넣어 모든 칸을 채우는 도형 퍼즐입니다. 단계가 올라갈수록 보드가 커지고 조각이 복잡해져, 블록을 놓는 순서를 신중히 생각해야 합니다.",
      "checkmate": "일반 체스판과 다른 500개 이상의 배치에서 상대 킹을 외통수로 몰아넣는 체스 퍼즐입니다. 각 판마다 제한된 기물과 배치를 살펴 가장 빠르게 체크메이트하는 방법을 찾아보세요.",
      "copy-the-drawing": "화면 위의 예시 그림을 보고 아래 캔버스에 최대한 똑같이 그리는 따라 그리기 게임입니다. 붓 크기를 바꿔 세부선을 맞추고, 18개 주제에 걸친 수백 개 단계에서 정확도를 높여 보세요.",
      "evolution-survival": "작은 원시 세포로 시작해 먹이와 DNA를 모으며 점점 강한 생명체로 진화하세요. 속도·독·재생 등 변이를 선택하고 바다에서 육지로 달라지는 환경 속에서 더 큰 포식자를 피해야 합니다.",
      "cyberpunk-block-puzzle": "네온 회로판 위의 블록을 움직여 같은 색의 연결 단자에 보내는 논리 퍼즐입니다. 각 블록은 정해진 축으로만 이동하므로 벽과 얼음, 잠금장치를 고려해 이동 순서를 계획해야 합니다.",
      "game-factory": "플랫포머·슈팅·러너 등 원하는 장르를 고르고 픽셀 그림과 스테이지를 직접 설계하는 게임 제작 시뮬레이터입니다. 만든 게임을 시험하고 공개해 얻은 보상으로 제작 스튜디오를 확장하세요.",
      "madness-online": "끝없이 생성되는 황폐한 세계에서 좀비와 적을 상대하는 탑다운 멀티플레이 생존 슈팅입니다. 자원을 모아 장비와 방어 기지를 만들고, 회피와 사격으로 홀로 또는 친구와 살아남으세요.",
      "voxel-master": "색색의 블록을 쌓아 3D 입체 모형을 완성하는 복셀 퍼즐입니다. 제시된 모형을 그대로 따라 만드는 단계와 자유롭게 작품을 만들고 저장하는 샌드박스 모드를 오갈 수 있습니다.",
      "dream-room": "침실·거실·카페 등 여섯 공간을 원하는 분위기로 꾸미는 인테리어 게임입니다. 침대와 소파, 조명, 커튼 등 250종이 넘는 물건을 배치하고 색상과 장식을 조합해 보세요.",
      "untangle-threads": "점들을 끌어 움직여 서로 엇갈린 실이 하나도 남지 않도록 푸는 퍼즐입니다. 움직이는 점과 고정된 점, 이동 횟수 제한 등 여섯 세계의 규칙에 맞춰 엉킨 선을 정리하세요.",
      "block-sculptor": "회색 큐브를 하나씩 제거해 블록 속에 숨겨진 알록달록한 입체 모형을 드러내세요. 3D 덩어리를 회전해 모든 각도를 살피고, 남겨야 하는 색깔 블록을 잘못 누르지 않아야 합니다.",
      "breinrot-bog": "물이 계속 차오르는 위험한 늪에서 빛나는 브레인롯을 모으며 높은 곳으로 이동하세요. 장애물을 넘고 지형을 읽어 늪에 삼켜지기 전에 자원을 모아 생존해야 합니다.",
      "hair-salon-3d": "손님의 주문 사진을 확인하고 가위·바리캉·염색 도구로 머리를 완성하는 3D 미용실 게임입니다. 요구한 길이와 모양을 최대한 비슷하게 재현해 별점과 팁을 얻으세요.",
      "pop-it-master": "알록달록한 팝잇의 돌기를 하나씩 눌러 모두 뒤집으면 다음 장난감이 열립니다. 다양한 모양과 색의 팝잇 및 심플 딤플을 모아 총 150종의 컬렉션 완성에 도전하세요.",
      "container-auction": "컨테이너 문틈으로 보이는 물건을 단서 삼아 안의 가치를 추정하고 경쟁 입찰에 참여하세요. 낙찰 후 물건을 확인해 희귀한 보물을 찾아내며 더 큰 경매에 도전할 수 있습니다.",
      "amigurumi-cozy-stitches": "곰·토끼·공룡 모양의 아미구루미 인형을 직접 만드는 공방 게임입니다. 실의 나선 모양을 따라 뜨개질하고 솜을 넣은 뒤 팔다리와 표정을 꾸며 인형을 완성하세요.",
      "mahjong-chef": "같은 그림의 마작 패 두 장을 찾아 제거하고 판을 비우는 퍼즐입니다. 한 단계를 마칠 때마다 재료를 모아 중국 요리책을 채우고, 새로운 요리와 마작 판을 해금해 보세요."
    }
  },
